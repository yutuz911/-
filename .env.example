# Server
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# Image2 / image-to-image provider
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MODERATION=auto
OPENAI_IMAGE_OUTPUT_FORMAT=png
# Optional. Use only for local machines that need a proxy to reach OpenAI.
OPENAI_PROXY_URL=

# Set to true for local UI testing without spending API credits.
MOCK_GENERATION=false

# Comma-separated origins allowed to call the API in production.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Per-IP generation throttle.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8

# Plugin-style production integrations. Leave blank to disable.

# Supabase: generation job records and optional generated image storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GENERATION_TABLE=generation_jobs
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC=false
STORE_PROMPTS=false

# Stripe: paid generation checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancel

# PostHog: privacy-aware product events.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Sentry: server error reporting.
SENTRY_DSN=

# Cloudflare Turnstile: abuse protection. Add the site key to the frontend via env.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
